#!/usr/bin/env bash
# llm-swap — A/B the local llama-server between gpt-oss-20b and gemma-4-12b.
#
# Only one model fits in 16 GB at a time, so both LaunchAgents serve :8080 and we
# load exactly one. Swapping also rewrites pi's `defaultModel` so the running
# server and pi's model label stay in sync.
#
#   llm-swap gpt-oss   # serve gpt-oss-20b   (MoE, ~3.6B active, ~43 tok/s)
#   llm-swap gemma     # serve gemma-4-12b   (dense 12B, slower/token, native tools)
#   llm-swap status    # show what's loaded + health + served model
set -euo pipefail

AGENTS_DIR="$HOME/Library/LaunchAgents"
PI_SETTINGS="$HOME/.pi/agent/settings.json"
GPTOSS_PLIST="$AGENTS_DIR/com.markhougaard.llama-server.plist"
GEMMA_PLIST="$AGENTS_DIR/com.markhougaard.llama-server-gemma.plist"
GPTOSS_MODEL="ggml-org/gpt-oss-20b-GGUF"
GEMMA_MODEL="unsloth/gemma-4-12b-it-GGUF"
HEALTH="http://127.0.0.1:8080/health"
MODELS="http://127.0.0.1:8080/v1/models"

die() { echo "error: $*" >&2; exit 1; }
usage() { echo "usage: llm-swap {gpt-oss|gemma|status}"; exit 1; }

set_default_model() {
  [ -f "$PI_SETTINGS" ] || { echo "warn: $PI_SETTINGS not found, skipping defaultModel update" >&2; return; }
  python3 - "$PI_SETTINGS" "$1" <<'PY'
import json, sys
path, model = sys.argv[1], sys.argv[2]
with open(path) as f:
    cfg = json.load(f)
cfg["defaultModel"] = model
with open(path, "w") as f:
    json.dump(cfg, f, indent=2)
    f.write("\n")
PY
}

wait_health() {
  echo "waiting for llama-server on :8080 (first run downloads the model)…"
  for _ in $(seq 1 600); do
    if curl -fsS "$HEALTH" >/dev/null 2>&1; then
      echo "ready: $(curl -fsS "$MODELS" | python3 -c 'import sys,json; print(json.load(sys.stdin)["data"][0]["id"])' 2>/dev/null || echo '?')"
      return 0
    fi
    sleep 1
  done
  die "timed out waiting for $HEALTH — check ~/.llama-cpp/logs/"
}

swap_to() {
  local target=$1 plist model
  case "$target" in
    gpt-oss) plist=$GPTOSS_PLIST; model=$GPTOSS_MODEL ;;
    gemma)   plist=$GEMMA_PLIST;  model=$GEMMA_MODEL ;;
    *) usage ;;
  esac
  [ -f "$plist" ] || die "missing $plist — copy it into $AGENTS_DIR first (see README step A/B)"

  # Stop whichever server is up (ignore 'not loaded' errors), then start the target.
  launchctl unload "$GPTOSS_PLIST" 2>/dev/null || true
  launchctl unload "$GEMMA_PLIST" 2>/dev/null || true
  launchctl load -w "$plist"
  set_default_model "$model"
  echo "swapped to $target → $model"
  wait_health
}

status() {
  echo "loaded LaunchAgents:"
  launchctl list | grep -E 'llama-server(-gemma)?$' || echo "  (none)"
  echo -n "pi defaultModel: "
  [ -f "$PI_SETTINGS" ] && python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("defaultModel","?"))' "$PI_SETTINGS" || echo "?"
  if curl -fsS "$HEALTH" >/dev/null 2>&1; then
    echo -n "served model: "
    curl -fsS "$MODELS" | python3 -c 'import sys,json; print(json.load(sys.stdin)["data"][0]["id"])' 2>/dev/null || echo "?"
  else
    echo "server: not responding on :8080"
  fi
}

[ $# -eq 1 ] || usage
case "$1" in
  gpt-oss|gemma) swap_to "$1" ;;
  status) status ;;
  *) usage ;;
esac
